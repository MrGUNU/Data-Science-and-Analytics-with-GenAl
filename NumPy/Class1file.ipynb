        "arange → step-based values\n",
        "\n",
        "linspace → fixed number of values\n",
        "\n",
        "eye → identity matrix\n",
        "\n",
        "rand → random floats (0–1)\n",
        "\n",
        "randint → random integers in a range\n",
        "\n",
        "randn → random values from bell curve distribution"
